# Base URL of the Django API (no trailing slash). The backend's CORS list
# allows http://localhost:5173 by default.
VITE_API_URL=http://127.0.0.1:8000

# "true" shows the ordering station's "Prototype only" advance button.
VITE_PROTOTYPE_CONTROLS=false

# "true" lets the sign-in role cards prefill the seeded demo usernames.
# Use only against a development database.
VITE_DEMO_PREFILL=false

# With VITE_DEMO_PREFILL=true, also prefill this password for the demo user
# (the seeded development accounts share one; see the root README).
VITE_DEMO_PASSWORD=

# Table ids to show on the Orders screen until GET /api/tables/ exists.
# A range ("1-12") or a list ("1001,1002,1003").
VITE_TABLE_IDS=1-12
